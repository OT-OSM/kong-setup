global
    maxconn 4000

defaults
    mode http
    timeout connect 5s
    timeout client  30s
    timeout server  30s

frontend kong_frontend
    bind *:80
    default_backend kong_backend

backend kong_backend
    balance roundrobin

    server kong1 3.22.225.33:8000 check
    server kong2 52.14.171.122:8000 check
    server kong3 18.225.113.129:8000 check
